  "apiResources": [
    {
      "name": "DataTalk API",
      "indicator": "https://api.dataluminary.local"
    },
    {
      "name": "VibeEdu API",
      "indicator": "https://api.vibeedu.local"
    },
    {
      "name": "VibeAgent API",
      "indicator": "https://api.vibeagent.local"
    },
    {
      "name": "DoerFlow API",
      "indicator": "https://api.doerflow.local",
      "scopes": [
        {
          "name": "integration.provider.register",
          "description": "Register or update DoerFlow integration provider offerings"
        },
        {
          "name": "integration.event.submit",
          "description": "Submit integration events that may create DoerFlow tasks"
        },
        {
          "name": "integration.callback.read",
          "description": "Read signed job/task lifecycle callbacks and correlation status"
        }
      ]
    },
    {
      "name": "VistaCast API",
      "indicator": "https://api.vistacast.local"
    },
    {
      "name": "VistaRemote API",
      "indicator": "https://api.vistaremote.local"
    },
    {
      "name": "IoT Gateway API",
      "indicator": "https://api.iotchain.local"
    },
    {
      "name": "Entitlement API",
      "indicator": "https://entitlement.luminaryworks.dev",
      "scopes": [
        {
          "name": "entitlement:admin",
          "description": "Superadmin Control Console and Entitlement /v1/admin APIs"
        },
        {
          "name": "entitlement:read",
          "description": "Read Entitlement catalog, health, and non-destructive admin lists"
        }
      ]
    }
  ],
  "m2mApplications": [
    {
      "name": "VistaCast Service",
      "type": "MachineToMachine",
      "description": "VistaCast server M2M caller for DoerFlow provider registration, event submit, and callback read. Token audience is DoerFlow API; no OIDC redirect/callback.",
      "resourceIndicator": "https://api.doerflow.local",
      "scopes": [
        "integration.provider.register",
        "integration.event.submit",
        "integration.callback.read"
      ]
    },
    {
      "name": "SyncroBrain Gateway",
      "type": "MachineToMachine",
      "description": "SyncroBrain iot-gateway M2M caller for DoerFlow provider registration, event submit, and callback read. Token audience is DoerFlow API; no OIDC redirect/callback.",
