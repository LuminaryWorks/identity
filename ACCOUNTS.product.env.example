# LuminaryWorks Identity — Product / 私有化平台用户（default 租户）
#
# 注意：这里不是 Logto Admin Console 操作员。
# Console 操作员请配置 identity/.env（或 CI secrets）的 LW_LOGTO_ADMIN_*。
#
# 用法（本地文件）：
#   cp ACCOUNTS.product.env.example ACCOUNTS.product.env
#   # 填入强密码后：
#   IDENTITY_ACCOUNTS_PROFILE=product ./bootstrap.sh
#
# 用法（GitHub Actions / 云部署）：
#   在 workflow / 服务器注入环境变量（无需落盘）：
#     IDENTITY_ACCOUNTS_PROFILE=product
#     LW_LOGTO_ADMIN_USERNAME=...
#     LW_LOGTO_ADMIN_PASSWORD=${{ secrets.LW_LOGTO_ADMIN_PASSWORD }}
#     LW_SUPER_ADMIN_EMAIL=...
#     LW_SUPER_ADMIN_PASSWORD=${{ secrets.LW_SUPER_ADMIN_PASSWORD }}
#     …（每个平台账号的 EMAIL / USERNAME / PASSWORD）
#
# 密码留空或仍为 CHANGE_ME 时，seed / 部署会直接失败。

IDENTITY_ACCOUNTS_PROFILE=product
SEED_ACCOUNTS_DOMAIN=luminaryworks.dev
IDP_ISSUER=https://login.luminaryworks.dev/oidc

# SUPER_ADMIN roles=super_admin,platform_admin
LW_SUPER_ADMIN_EMAIL=superadmin@luminaryworks.dev
LW_SUPER_ADMIN_USERNAME=superadmin
LW_SUPER_ADMIN_PASSWORD=

# ADMIN_DATALUMINARY roles=dataluminary_admin
LW_ADMIN_DATALUMINARY_EMAIL=admin.dataluminary@luminaryworks.dev
LW_ADMIN_DATALUMINARY_USERNAME=admin_dataluminary
LW_ADMIN_DATALUMINARY_PASSWORD=

# ADMIN_BLOCKYEDU roles=blockyedu_admin
LW_ADMIN_BLOCKYEDU_EMAIL=admin.blockyedu@luminaryworks.dev
LW_ADMIN_BLOCKYEDU_USERNAME=admin_blockyedu
LW_ADMIN_BLOCKYEDU_PASSWORD=

# ADMIN_DOERFLOW roles=doerflow_admin
LW_ADMIN_DOERFLOW_EMAIL=admin.doerflow@luminaryworks.dev
LW_ADMIN_DOERFLOW_USERNAME=admin_doerflow
LW_ADMIN_DOERFLOW_PASSWORD=

# ADMIN_VISTAREMOTE roles=vistaremote_admin
LW_ADMIN_VISTAREMOTE_EMAIL=admin.vistaremote@luminaryworks.dev
LW_ADMIN_VISTAREMOTE_USERNAME=admin_vistaremote
LW_ADMIN_VISTAREMOTE_PASSWORD=

# ADMIN_VISTACAST roles=vistacast_admin
LW_ADMIN_VISTACAST_EMAIL=admin.vistacast@luminaryworks.dev
LW_ADMIN_VISTACAST_USERNAME=admin_vistacast
LW_ADMIN_VISTACAST_PASSWORD=

# ADMIN_SYNCROBRAIN roles=syncrobrain_admin
LW_ADMIN_SYNCROBRAIN_EMAIL=admin.syncrobrain@luminaryworks.dev
LW_ADMIN_SYNCROBRAIN_USERNAME=admin_syncrobrain
LW_ADMIN_SYNCROBRAIN_PASSWORD=
