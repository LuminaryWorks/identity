# LuminaryWorks Identity — 本地开发配置
# 复制为 .env： cp .env.example .env

# ── 服务端口 ──
IDENTITY_PORT=3001
IDENTITY_ADMIN_PORT=3002
IDENTITY_DB_PORT=5433
IDENTITY_REDIS_PORT=6381
IDENTITY_DB_PASSWORD=logto_dev_password

# ── 对外地址（供产品 .env 引用）──
IDENTITY_ENDPOINT=http://localhost:3001
IDENTITY_ADMIN_ENDPOINT=http://localhost:3002
IDENTITY_BRAND_ENDPOINT=https://cdn.luminaryworks.dev/logo

# ── Console 品牌 overlay 镜像（identity/branding/Dockerfile 本地构建）──
LOGTO_VERSION=1.42.0
IDENTITY_IMAGE=luminaryworks/identity:1.42.0-lw1

# ── IAM 插件（已冻结：默认 Logto，不要改成 ZITADEL 当作默认）──
# logto = 本 compose（Experience Headless + Management）
# oidc / zitadel = 产品侧可选；本仓 register/seed 仍要求 logto
IAM_PROVIDER=logto
IDP_ISSUER=http://localhost:3001/oidc

# ── Logto Admin Console 操作员（admin 租户）──
# 与 ACCOUNTS.*.env 平台用户不是同一维度。缺省或 CHANGE_ME 时 bootstrap 中断。
# 登录：http://localhost:3002
LW_LOGTO_ADMIN_EMAIL=logto.admin@luminaryworks.local
LW_LOGTO_ADMIN_USERNAME=logto_admin
LW_LOGTO_ADMIN_PASSWORD="LuminaryDev!234"
# 已存在用户时默认不改密；需要重置时设为 1
# LW_LOGTO_ADMIN_RESET_PASSWORD=1

# ── 应用注册脚本所需（Logto Management API，M2M）──
# 通常由 scripts/bootstrap-m2m.mjs 自动写入；也可手工填：
# 这是 identity 运维 Management API 凭据，不是 VistaCast/SyncroBrain 产品 M2M。
# 产品 M2M client_id 见 registered-apps.json 的 m2m 字段；secret 只从 Logto Admin 复制到产品服务 env。
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api

# ── 社交登录（可选；不填则产品 Headless 不显示 Google/GitHub 按钮）──
# 在 Google Cloud / GitHub OAuth App 创建后填入。回调由 ensure-social-connectors.mjs 打印：
#   http://localhost:3001/callback/<connectorId>
# LOGTO_GOOGLE_CLIENT_ID=
# LOGTO_GOOGLE_CLIENT_SECRET=
# LOGTO_GITHUB_CLIENT_ID=
# LOGTO_GITHUB_CLIENT_SECRET=

# ── 系统账号 seed（dev / product）──
# 本地：cp ACCOUNTS.dev.env.example ACCOUNTS.dev.env 后 bootstrap
# 云部署：IDENTITY_ACCOUNTS_PROFILE=product + LW_* 环境变量 / secrets
# 未配置齐全时 seed / bootstrap 直接失败（无交互）
IDENTITY_ACCOUNTS_PROFILE=dev

# 认证邮件（Logto HTTP Email → Notification Service）
#   dev 默认关；product 默认开。显式 EMAIL_AUTH_ENABLED=0|1 覆盖。
#   开：注册 Email OTP，日常登录仍是密码，高风险走 Adaptive MFA（不是全员强制 TOTP）
#   关：内网私有化。不安装 http-email connector。
# EMAIL_AUTH_ENABLED=0
# NOTIFICATION_EMAIL_ENDPOINT=http://host.docker.internal:3050/internal/logto/email
# NOTIFICATION_SERVICE_KEY=
#
# 测试仍可临时：node scripts/ensure-force-mfa.mjs --on ，测完 --restore / --off
# 不要在 bootstrap 里把 product 设成全员 Mandatory TOTP。
