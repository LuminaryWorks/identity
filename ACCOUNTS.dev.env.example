# LuminaryWorks Identity — DEV 平台用户（default 租户 / 产品登录）
#
# 注意：这里不是 Logto Admin Console（:3002）操作员。
# Console 操作员请配置 identity/.env 的 LW_LOGTO_ADMIN_*（见 .env.example）。
#
# 用法：
#   cp ACCOUNTS.dev.env.example ACCOUNTS.dev.env
#   # 按需改密码后：
#   IDENTITY_ACCOUNTS_PROFILE=dev ./bootstrap.ps1
#   # 或：node scripts/seed-accounts.mjs
#
# 也可不写文件，直接在 shell / CI 注入同名 LW_* 环境变量。
# 未配置齐全时 init / seed 会直接失败（不交互、不自动复制）。

IDENTITY_ACCOUNTS_PROFILE=dev
SEED_ACCOUNTS_DOMAIN=luminaryworks.local
IDP_ISSUER=http://localhost:3001/oidc

# SUPER_ADMIN roles=super_admin,platform_admin
LW_SUPER_ADMIN_EMAIL=superadmin@luminaryworks.local
LW_SUPER_ADMIN_USERNAME=superadmin
LW_SUPER_ADMIN_PASSWORD="LuminaryDev!234"

# ADMIN_DATALUMINARY roles=dataluminary_admin
LW_ADMIN_DATALUMINARY_EMAIL=admin.dataluminary@luminaryworks.local
LW_ADMIN_DATALUMINARY_USERNAME=admin_dataluminary
LW_ADMIN_DATALUMINARY_PASSWORD="LuminaryDev!234"

